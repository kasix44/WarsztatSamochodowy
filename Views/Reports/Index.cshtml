@model WorkshopManager.Models.ReportFilterViewModel

<div class="container mt-4">
    <h2>Generowanie raportu</h2>

    <form asp-action="Generate" method="post" class="mt-4">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="CustomerEmail">Klient</label>
                    <select asp-for="CustomerEmail" asp-items="Model.Customers" class="form-control">
                        <option value="">-- Wybierz klienta --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="LicensePlate">Pojazd</label>
                    <select asp-for="LicensePlate" asp-items="Model.LicensePlates" class="form-control">
                        <option value="">-- Wybierz pojazd --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Month">Miesiąc i rok (MM.RRRR)</label>
                    <input asp-for="Month" type="month" class="form-control" />
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-12">
                <button type="submit" class="btn btn-primary">Generuj raport</button>
            </div>
        </div>
    </form>
</div>