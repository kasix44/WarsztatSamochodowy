@model WorkshopManager.Models.ReportViewModel

<div class="container mt-4">
    <h2>Raport zleceń serwisowych</h2>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Liczba zleceń</h5>
                    <p class="card-text display-4">@Model.TotalOrders</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Liczba części</h5>
                    <p class="card-text display-4">@Model.TotalParts</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Liczba czynności</h5>
                    <p class="card-text display-4">@Model.TotalActivities</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Koszt całkowity</h5>
                    <p class="card-text display-4">@Model.TotalCost.ToString("C")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Data rozpoczęcia</th>
                    <th>Status</th>
                    <th>Pojazd</th>
                    <th>Klient</th>
                    <th>Mechanik</th>
                    <th>Liczba części</th>
                    <th>Liczba czynności</th>
                    <th>Koszt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>@order.Status</td>
                        <td>@($"{order.Vehicle?.Brand} {order.Vehicle?.Model} ({order.Vehicle?.LicensePlate})")</td>
                        <td>@($"{order.Vehicle?.Customer?.FirstName} {order.Vehicle?.Customer?.LastName}")</td>
                        <td>@order.AssignedMechanic?.UserName</td>
                        <td>@(order.UsedParts?.Count ?? 0)</td>
                        <td>@(order.JobActivities?.Count ?? 0)</td>
                        <td>@(((order.UsedParts?.Sum(up => (up.Part?.UnitPrice ?? 0) * up.Quantity) ?? 0) + (order.JobActivities?.Sum(ja => ja.LaborCost) ?? 0)).ToString("C"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Powrót do filtrowania</a>
        <a asp-action="ExportPdf" class="btn btn-success">Wyeksportuj jako PDF</a>
    </div>
</div> 